<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="seed_hibrid_form_view" model="ir.ui.view">
        <field name="name">seed.hibrid.from</field>
        <field name="model">seed.hibrid</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="hibrid_code" string="Código del híbrido" />
                        <h1>
                            <field
                                name="hibrid_code"
                                placeholder="Ej. F387HA"
                            />
                        </h1>
                    </div>
                    <group>
                        <field name="vegetable_id" />
                        <field name="company_id" />
                        <field name="name" />
                    </group>
                    <notebook>
                        <page string="Orden de entrega">
                            <field name="arrival_order_ids">
                                <list>
                                    <field name="arrival_date" />
                                    <field name="invoice_number" />
                                    <field name="amount" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="seed_hibrid_list_view" model="ir.ui.view">
        <field name="name">seed.hibrid.list</field>
        <field name="model">seed.hibrid</field>
        <field name="arch" type="xml">
            <list>
                <field name="hibrid_code" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="seed_hibrid_action" model="ir.actions.act_window">
        <field name="name">Hibridos</field>
        <field name="res_model">seed.hibrid</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
