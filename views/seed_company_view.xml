<? xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form view -->
    <record id="seed_company_form_view" model="ir.ui.view">
        <field name="name">seed.company.form</field>
        <field name="model">seed.company</field>
        <field name="arch" type="xml">
            <form string="Empresa">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="seed_company_list_view" model="ir.ui.view">
        <field name="name">seed.company.list</field>
        <field name="model">seed.company</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="seed_company_action" model="ir.actions.act_window">
        <field name="name">Empresas</field>
        <field name="res_mode">seed.company</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
