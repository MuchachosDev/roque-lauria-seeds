<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="seed_stock_list_view" model="ir.ui.view">
        <field name="name">seed.stock.list</field>
        <field name="model">seed.stock</field>
        <field name="arch" type="xml">
            <list string="Inventario" create="0">
                <field name="hibrid_id"/>
                <field name="package_type"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="seed_stock_action" model="ir.actions.act_window">
        <field name="name">Inventario</field>
        <field name="res_model">seed.stock</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existe stock cargado actualmente. Cargue ordenes de entrada.
            </p>
        </field>
    </record>
</odoo>
