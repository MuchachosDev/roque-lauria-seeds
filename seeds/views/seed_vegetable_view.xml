<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form view -->
    <record id="seed_vegetable_form_view" model="ir.ui.view">
        <field name="name">seed.vegetable.form</field>
        <field name="model">seed.vegetable</field>
        <field name="arch" type="xml">
            <form string="Hortaliza">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre del laboratorio"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Hibridos">
                            <field name="hibrid_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="seed_vegetable_list_view" model="ir.ui.view">
        <field name="name">seed.vegetable.list</field>
        <field name="model">seed.vegetable</field>
        <field name="arch" type="xml">
            <list string="Hortalizas">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="seed_vegetable_action" model="ir.actions.act_window">
        <field name="name">Hortaliza</field>
        <field name="res_model">seed.vegetable</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen hortalizas cargados en el sistema. Cargue algunos.
            </p>
        </field>
    </record>
</odoo>
