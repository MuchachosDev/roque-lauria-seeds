<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seed_result_order_form_view" model="ir.ui.view">
        <field name="name">seed.result.order.form</field>
        <field name="model">seed.result.order</field>
        <field name="arch" type="xml">
            <form string="Orden de resultado">
                <sheet>
                    <div class="oe_title">
                        <label for="order_number" string="Orden de resultado" />
                        <h1>
                            <field name="order_number" readonly="1" />
                        </h1>
                    </div>

                    <group>
                        <group string="Datos del ensayo">
                            <field name="farmer" />
                            <field name="distributor" />
                            <field name="season" />
                            <field name="test_fiability" />
                            <field name="lines_amount" />
                            <field name="harvest_method" />
                            <field name="substratum" />
                        </group>

                        <group string="Fechas y ubicación">
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="seed_date" />
                            <field name="replant_date" />
                            <label for="lat_coord" string="Coordenadas" />
                            <div class="o_row">
                                <field name="lat_coord" placeholder="Latitud" />
                                <field name="lon_coord" placeholder="Longitud" />
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Resultados por variedad">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="hibrid_id" />
                                    <field name="vegetable_name" readonly="1" />
                                    <field name="land_code" />
                                    <field name="evaluation_date" />
                                </list>

                                <form string="Resultado por variedad">
                                    <sheet>
                                        <group>
                                            <group string="Datos básicos">
                                                <field name="hibrid_id" />
                                                <field name="vegetable_name" readonly="1" />
                                                <field name="land_code" />
                                                <field name="evaluation_date" />
                                            </group>

                                            <group string="Adjuntos">
                                                <field name="photo" widget="many2many_binary" />
                                            </group>
                                        </group>

                                        <notebook>
                                            <page string="Evaluación" invisible="not hibrid_id">
                                                <field name="experiment_result" widget="html"
                                                    nolabel="1" />
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="seed_result_order_list_view" model="ir.ui.view">
        <field name="name">seed.result.order.list</field>
        <field name="model">seed.result.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_number" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="season" />
                <field name="farmer" />
            </list>
        </field>
    </record>

    <record id="seed_result_order_action" model="ir.actions.act_window">
        <field name="name">Ordenes de resultado</field>
        <field name="res_model">seed.result.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>