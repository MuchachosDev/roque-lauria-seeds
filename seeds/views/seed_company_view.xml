<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form view -->
    <record id="seed_company_form_view" model="ir.ui.view">
        <field name="name">seed.company.form</field>
        <field name="model">seed.company</field>
        <field name="arch" type="xml">
            <form string="Laboratorio">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre del laboratorio"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Híbridos desarrollados">
                            <field name="hibrid_ids" readonly="1">
                                <list>
                                    <field name="hibrid_code"/>
                                    <field name="name"/>
                                    <field name="vegetable_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="seed_company_list_view" model="ir.ui.view">
        <field name="name">seed.company.list</field>
        <field name="model">seed.company</field>
        <field name="arch" type="xml">
            <list string="Laboratorios">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="seed_company_action" model="ir.actions.act_window">
        <field name="name">Laboratorios</field>
        <field name="res_model">seed.company</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen laboratorios cargados en el sistema. Cargue algunos.
            </p>
        </field>
    </record>
</odoo>
