<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="seed_destinatary_form_view" model="ir.ui.view">
        <field name="name">seed.destinatary.form</field>
        <field name="model">seed.destinatary</field>
        <field name="arch" type="xml">
            <form string="Destinatario">
                <sheet>
                    <div class="oe_title">
                        <label for="complete_name" string="Nombre completo" />
                        <h1>
                            <field name="complete_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Datos personales">
                            <field name="first_name"/>
                            <field name="last_name"/>
                        </group>
                        <group string="Datos de recidencia">
                            <field name="city"/>
                            <field name="country_id" invisible="1"/>
                            <field name="state_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Paquetes enviados">
                            <field name="deperture_order_ids">
                                <list create="0">
                                    <field name="order_number"/>
                                    <field name="deperture_date"/>
                                    <field name="arrival_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="seed_destinatary_list_view" model="ir.ui.view">
        <field name="name">seed.destinatary.list</field>
        <field name="model">seed.destinatary</field>
        <field name="arch" type="xml">
            <list string="Destinatarios">
                <field name="complete_name"/>
                <field name="city"/>
                <field name="state_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="seed_destinatary_action" model="ir.actions.act_window">
        <field name="name">Destinatarios</field>
        <field name="res_model">seed.destinatary</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No existen destinatarios cargados en el sistema. Cargue algunos.
            </p>
        </field>
    </record>
</odoo>
