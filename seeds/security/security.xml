<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seed Manager -->
    <record id="group_seed_manager" model="res.groups">
        <field name="name">Seed Manager</field>
        <field name="comment">The user will be able to create, delete and edit all models</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <!-- Seed Engineer -->
    <record id="group_seed_engineer" model="res.groups">
        <field name="name">Seed Engineer</field>
        <field name="comment">The user will be able to edit some fields on the departure order and create edit and delete result orders</field>
    </record>
</odoo>
