<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_seed_deperture_order_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <h2 class="mt-4 mb-4">
                            <span>Orden de Salida:</span>
                            <span t-field="o.order_number"/>
                        </h2>
                        
                        <div class="row mt-4 mb-3" id="general_information_row_1">
                            <div class="col-4 text-break" t-if="o.destinatary_name">
                                <strong>Destinatario:</strong>
                                <div t-field="o.destinatary_name"/>
                            </div>
                            <div class="col-4 text-break" t-if="o.destinatary_city">
                                <strong>Localidad:</strong>
                                <div t-field="o.destinatary_city"/>
                            </div>
                            <div class="col-4 text-break" t-if="o.deperture_date">
                                <strong>Fecha de envío:</strong>
                                <div t-field="o.deperture_date"/>
                            </div>
                        </div>

                        <div class="row mb-5" id="general_information_row_2">
                            <div class="col-4 text-break" t-if="o.arrival_date">
                                <strong>Fecha de recepción:</strong>
                                <div t-field="o.arrival_date"/>
                            </div>
                            <div class="col-4 text-break" t-if="o.batch">
                                <strong>Batch:</strong>
                                <div t-field="o.batch"/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table mt-4">
                            <thead class="bg-light">
                                <tr>
                                    <th name="th_vegetable" class="p-2">Hortaliza</th>
                                    <th name="th_hibrid" class="p-2">Híbrido</th>
                                    <th name="th_code" class="p-2">Código</th>
                                    <th name="th_amount" class="p-2">Cantidad</th>
                                    <th name="th_package" class="p-2">Presentación</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.item_ids" t-as="line">
                                    <tr>
                                        <td class="p-2"><span t-field="line.vegetable"/></td>
                                        <td class="p-2"><span t-field="line.hibrid_name"/></td>
                                        <td class="p-2"><span t-field="line.hibrid_code"/></td>
                                        <td class="p-2"><span t-field="line.amount"/></td>
                                        <td class="p-2"><span t-field="line.package_type"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="mt-4" t-if="o.observation">
                            <strong>Observaciones:</strong>
                            <div t-field="o.observation"/>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_seed_deperture_order" model="ir.actions.report">
        <field name="name">Orden/es de Salida</field>
        <field name="model">seed.deperture.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">seeds.report_seed_deperture_order_template</field>
        <field name="report_file">seeds.report_seed_deperture_order_template</field>
        <field name="binding_model_id" ref="model_seed_deperture_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>